# Copy to .env for local runs:  cp .env.example .env
# In GitHub Actions these come from repository Secrets/Variables, not this file.

# --- Required ---
API_FOOTBALL_KEY=            # API-Football key (Pro plan). Needed for backfill/refresh/picks/results.
PICKS_API_KEY=               # vowtips.com API key, sent as the x-api-key header. Needed only to send.

# --- Optional: delivery ---
# PICKS_TEST_MODE=true       # send every pick with "test": true (stored by the site, never shown)
# PICKS_ENDPOINT_URL=https://vowtips.com/api/public/picks      # override the picks URL (e.g. a mock)
# RESULTS_ENDPOINT_URL=https://vowtips.com/api/public/results  # override the results URL
# PICKS_TIMEZONE=Europe/Belgrade   # which calendar day counts as "today"

# --- Optional: pick selection (see README > Configuration) ---
# VIP_MIN=3                  # min VIP picks per day
# VIP_MAX=5                  # max VIP picks per day
# MIN_EV=0.0                 # minimum expected value for a value pick (0.05 = +5%)
# MIN_ODDS=1.40              # lowest price picks are chosen from
# MAX_ODDS=3.50              # highest price picks are chosen from
# RANK_BY=probability        # "probability" (most likely first) or "ev" (highest expected value first)
# UNITS=1                    # stake sent with each pick
# ODDS_BOOKMAKER_ID=         # price at one bookmaker instead of the median of all, e.g. 8 = Bet365
