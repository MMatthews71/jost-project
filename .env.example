# Copy to .env for local runs. On GitHub these are repository secrets.
API_FOOTBALL_KEY=
PICKS_API_KEY=

# Keep this on while testing locally: picks are stored by the site but never shown to members.
PICKS_TEST_MODE=true

# Optional (defaults shown)
# VIP_MIN=3
# VIP_MAX=5
# MIN_EV=0.0
# MIN_ODDS=1.40
# MAX_ODDS=3.50
# RANK_BY=probability            # or "ev"
# UNITS=1
# ODDS_BOOKMAKER_ID=8            # price picks at one bookmaker (8 = Bet365) instead of the market median
# PICKS_TIMEZONE=Europe/Belgrade
# APIFOOTBALL_MIN_INTERVAL=6.5   # seconds between API calls; only needed on the Free plan
